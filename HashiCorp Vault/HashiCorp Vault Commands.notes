# - It can be assigned by creating an entity and associating the user's login with the entity
# - Will be inherited when a user is a member of one or more Vault groups

# Customizing the Path
# - secret/apps/application1/*-allows any path after application1
# - kv/platform/db-* -would match kv/platform/db-2but not kv/platform/db
# - kv/data/apps/+/webapp–matches the following: (or kv/data/apps/+/+/webapp–matches, kv/data/apps/+/webapp–matches/*)
#   - kv/data/apps/dev/webapp
#   - kv/data/apps/qa/webapp
#   - kv/data/apps/prod/webapp

# Two key parts of a policy: path + capabilities
path "<path>" {
   capabilities = ["<list of permissions>"]
}

# ACL Templating
# Use variable replacementin some policy strings with values available to the token
# Define policy paths containing double curly braces: {{<parameter>}}
# Example: Creates a section of the key/value v2 secret engine for a each user:
path "secret/data/{{identity.entity.id}}/*" {
  capabilities = ["create", "update", "read", "delete"]
}

path "secret/metadata/{{identity.entity.id}}/*" {
  capabilities = ["list"]
}

# +---------------------------------------------------------------+------------------------------------------------------------+
# | Parameter                                                     | Description                                                |
# +---------------------------------------------------------------+------------------------------------------------------------+
# | identity.entity.id                                            | The entity's ID                                            |
# | identity.entity.name                                          | The entity's name                                          |
# | identity.entity.metadata.<<metadata key>>                     | Metadata associated with the entity for the given key      |
# | identity.entity.aliases.<<mount accessor>>.id                 | Entity alias ID for the given mount                        |
# | identity.entity.aliases.<<mount accessor>>.name               | Entity alias name for the given mount                      |
# | identity.entity.aliases.<<mount accessor>>.metadata.<<...>>   | Metadata associated with the alias for the given mount and |
# |                                                               | metadata key                                               |
# | identity.groups.ids.<<group id>>.name                         | The group name for the given group ID                      |
# | identity.groups.names.<<group name>>.id                       | The group ID for the given group name                      |
# | identity.groups.names.<<group id>>.metadata.<<metadata key>>  | Metadata associated with the group for the given key       |
# | identity.groups.names.<<group name>>.metadata.<<metadata key>>| Metadata associated with the group for the given key       |
# +--------------------------------------------------------------+-------------------------------------------------------------+

# Capabilities define what we can do on the defined path
# Specified as a list of strings within the policy (even if there's just one)
# Capability      HTTP Verb
# create          POST/PUT
# read            GET
# update          POST/PUT
# delete          DELETE
# list            LIST

# Capability           Description
# sudo                 Allows access to paths that are root-protected
# deny                 Disallows access regardless of any other defined capabilities

# - create= if the key does not yet exist
# - update= if the key exists and you want to replace/update it

# Vault policy commands
vault policy write <policy_name> <policy_file> # write for creating/updating a policy
vault policy read <policy_name>
vault policy delete <policy_name>
vault policy list
vault policy fmt <policy_file>

# /tmp/policy.hcl
path "/secrets/data/app" {
  capabilities = ["read", "list"]
} 

path "/secrets/metadata/*" {
  capabilities = ["read", "list"]
} 

path "kv/apps/webapp/*" {
   capabilities = ["read"]
} 

path "kv/apps/webapp/super_secret" {
   capabilities = ["deny"]
} 

vault policy write user-policy /tmp/kv-policy.hcl
vault token create -policy=user-policy -orphan -ttl=1h -renewable=true

vault login <VAULT_TOKEN>
export VAULT_TOKEN=<VAULT_TOKEN>
vault login
vault kv list secrets
vault kv read secrets/app
vault kv get secrets/app
vault kv put secrets/app value=secret
vault kv put secrets/new-app value=secret

vault policy list
vault policy write admin-policy /tmp/admin.hcl
vault policy read admin-policy
vault policy delete admin-policy
vault policy fmt /tmp/admin.hcl

path "*" {
    capabilities = ["read","create","update","delete","list","sudo"]
}

path "sys/policies/*" {
 capabilities = ["create","update","list","delete"]
}

path "aws/creds/web-*" {
 capabilities = ["read"]
}


# Examples of root-protected paths:
# - auth/token/create-orphan (create an orphan token)
# - sys/rotate (rotate the encryption key)
# - sys/seal (manually seal Vault)
# - pki/root/sign-self-issued (sign a self-issued certificate)
# - sys/step-down (force the leader to give up active status)


# Create a new token with "web-app" policy attached
vault token create -policy="web-app"

# Configure License
path "sys/license" {
  capabilities = ["read", "list", "create", "update", "delete"]
}
# Initialize Vault
path "sys/init" {
  capabilities = ["read", "update", "create"]
}
# Configure UI in Vault
path "sys/config/ui" {
  capabilities = ["read", "list", "update", "delete", "sudo"]
}
# Allow rekey of unseal keys for Vault
path "sys/rekey/*" {
  capabilities = ["read", "list", "update", "delete"]
}
# Allows rotation of master key
path "sys/rotate" {
  capabilities = ["update", "sudo"]
}
# Allows Vault seal
path "sys/seal" {
  capabilities = ["sudo"]
}




# Vault Tokens
vault token lookup hvs.d1BCdhug8buTgAnSZhtPm8Hp

# Controlling Token Lifecycle
# +--------------------------------------------------------------------------+--------------------------------+
# | Challenge                                                                | Solution                       |
# +--------------------------------------------------------------------------+--------------------------------+
# | I have a long-running app which cannot handle the regeneration of a      | Periodic Service Token         |
# | token or secret                                                          |                                |
# +--------------------------------------------------------------------------+--------------------------------+
# | I need a token that gets revoked automatically after one use             | Service Token with Use Limit   |
# +--------------------------------------------------------------------------+--------------------------------+
# | My app can't use a token where its expiration is influenced by its       | Orphan Service Token           |
# | parent                                                                   |                                |
# +--------------------------------------------------------------------------+--------------------------------+

# Periodic Token
# Periodic tokens are a type of token in HashiCorp Vault that have a defined time-to-live (TTL) and can be renewed indefinitely until they are revoked. 
# They are useful for long-running applications that need to maintain access to Vault without having to handle the regeneration of tokens or secrets. Periodic tokens can be created with a specific TTL and can be renewed before they expire, allowing for continuous access to Vault resources.
# Rootor sudousers have the ability to generate periodic tokens
path "auth/token/create" {
  capabilities = [ "create", "read", "update", "delete", "sudo" ]
}
# Periodic tokens have a TTL, but no max TTL
# Periodic tokens may live for an infinite amount of time, so long as they are renewed within their TTL
# So as long as you go and renew this particular token before this, 23 hours, 59 minutes and 28 seconds
# expires, you can renew this token as many times as you want Hundreds, thousands, whatever you can
# This token can live for years, as long as you renew it within that 24 hour time frame
vault token create -policy=training -period=24h

# Service Token with Use Limits
# When you want to limit the number of requests coming to Vault from a particular token:
# - Limit the token's number of uses in addition to TTL and Max TTL
# - Use limit tokens expire at the end of their last use, regardless of their remaining TTLs (be used three times, after the third time, it's going to be revoked immediately)
# - Use limit tokens expire at the end of their TTLs, regardless of remaining uses
vault token create -policy="training" -use-limit=2
vault token lookup hvs.516LO9Ssk1CQzvKo8ny1G0eu

# Orphan Token
# When the token hierarchy behavior is not desirable:
# - Only root tokensor sudousers have the ability to generate orphan tokens
path "auth/token/create-orphan" {
  capabilities = [ "create", "read", "update", "delete", "sudo" ]
}
# - Orphan tokens are not children of their parent token; therefore, they do not expire when their parent token does
# - Orphan tokens still expire when their own Max TTL is reached
vault token create -policy="training" -orphan
vault token lookup hvs.3rPJCQbGWD9O6uybtTuojjFs

# CIDR-Bound Token
# You want a token that can only be used by a specific host or within a certain network block
# Configured using a Token Role or Different Auth Methods
# it's just a regular service token with additional CIDR-bound configuration

# a couple of different ways that we can actually set the token type when we create a token
# To configure the AppRoleauth method to generate batch tokens
vault auth enable approle
vault write auth/approle/role/training policies="training" \
            token_type="batch" \
            token_ttl="60s"
# To configure the AppRoleauth method to generate periodic tokens
vault write auth/approle/role/jenkins policies="jenkins" \
            period="72h"

# Use the vault token command:
vault token create -display_name=jenkins \
                   -policy=training,certs \
                   -ttl=24h \
                   -explicit-max-ttl=72h
vault token lookup hvs.516LO9Ssk1CQzvKo8ny1G0eu
vault token lookup -accessor 516LO9Ssk1CQzvKo8ny1G0eu
vault token renew hvs.516LO9Ssk1CQzvKo8ny1G0eu
vault token renew -accessor 516LO9Ssk1CQzvKo8ny1G0eu
vault token revoke hvs.516LO9Ssk1CQzvKo8ny1G0eu
vault token revoke -accessor 516LO9Ssk1CQzvKo8ny1G0eu 
vault token capabilities hvs.dhtIk8VsE3Mj61PuGP3ZfFrg sys/policy/default


# Root Tokens (Where do Root TokensCome From?)
# - The initial root token comes from Vault initialization
vault operator init -key-shares=5 -key-threshold=3
# - Create a root token from an existing root token
vault login hvs.lmmOCfNH1HZvvBwxnLErWrhK
vault token create
# - Create a root token using unseal/recovery keys
#   Helpful if you need to generate a root token in an emergency or a root token is needed for a particular task
#   To perform the task, use the vault operator generate-root command
# +------------------+---------------------------------------------------------------+
# | Options          | Description                                                   |
# +------------------+---------------------------------------------------------------+
# | -generate-otp    | Generate and print a high-entropy one-time password (OTP)     |
# +------------------+---------------------------------------------------------------+
# | -init            | Start a root token generation                                 |
# +------------------+---------------------------------------------------------------+
# | -decode=<string> | Decode and output the generated root token                    |
# +------------------+---------------------------------------------------------------+
# | -otp=<string>    | OTP code to use with -decode or -init                         |
# +------------------+---------------------------------------------------------------+
# | -status          | Print the status of the current attempt                       |
# +------------------+---------------------------------------------------------------+
# | -cancel          | Cancel the current attempt                                    |
# +------------------+---------------------------------------------------------------+
vault login <root_token>
vault operator generate-root -init # One-Time-Password (OTP) gets generated "OTP: hM9q24nNiZfnYIiNvhnGo4UFc3"
vault operator generate-root # Key holders each provide their key until you meet the threshold (it's going to ask them for their unseal or their recovery key)
vault operator generate-root # Encrypted Root Token "Encoded Token: G2NeKUZgXTsYYxILAC9ZFBguPw9ZXBovFAs" is generated
vault operator generate-root \
      -otp="hM9q24nNiZfnYIiNvhnGo4UFc3" \
      -decode="G2NeKUZgXTsYYxILAC9ZFBguPw9ZXBovFAs"


# Secrets Engines
# Use the vault secretscommand
vault secrets enable aws
vault secrets enable -description="Static Secrets" -path="cloud-kv" kv-v2
vault secrets disable aws
vault secrets list
vault secrets list -detailed
vault secrets move -path=aws aws
vault secrets tune -default-lease-ttl=72h pki/

# Configuring a Secrets Engine
# There are generally two steps when configuring a secrets engine that will generate dynamic credentials:
# 1. Configure Vault with access to the platform
# 2. Configure Roles based on permissions needed

# Credentials can be provided using IAM credentials, an EC2
# instance role, or setting environment variables  
# Provide credentials to a secrets engine that gives Vault permission to create, list, and delete credentials on the platform:
vault write aws/config/root \
      access_key=AKIAIOSFODNN7EXAMPLE \
      secret_key= wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\
      region=us-east-1

# Provide credentials to a secrets engine that gives Vault permission to create, list, and delete credentials on the platform
vault write database/config/prod-database \
      plugin_name=mysql-aurora-database-plugin \
      connection_url="{{username}}:{{password}}@tcp(prod.cluster.us-east-1.rds.amazonaws.com:3306)/" \
      allowed_roles="app-integration, app-lambda" \
      username="vault-admin" \
      password="vneJ4908fkd3084Bk39fmslslf#e&349"

# Vault does not know what permissions, groups, and policies you want to attach to generated credentials. Each rolemaps to a set of permissions on the targeted platform.
# Note: if you use the IAM user credential in AWS and you generate credentials against AWS, it actually creates a user an IAM user in there as same as database
# data-consultant role we created
vault read aws/creds/data-consultant

# oracle-reporting role we created
vault read database/creds/oracle-reporting


# Secrets Engine
vault secrets enable kv
vault secrets enable kv-v2
vault secrets enable -path=training kv
vault secrets enable -path=training -version=2 kv
vault secrets list -detailed

# You can upgrade a KV v1 secrets engine to a KV v2
vault kv enable-versioning training/

# How is KV V2 Different?
# The data/and metadata/prefix is required for accessing the API and when writing Vault policies
# Introduces two prefixes that must be accounted for when referencing secrets and/or metadata
# - kv2/data data is where the actual K/V data is stored
# - kv2/metadata the metadata prefix stores our metadata about a secret

# Working with KV using the CLI
vault kv put secret/demo username="demo" password="<password>"  # write data to the KV like create 
vault kv get secret/demo
vault kv metadata get secret/demo
vault kv metadata put -custom-metadata=env=dev secret/demo
# to permanently delete all the metadata and versions for your key
vault kv metadata delete secret/demo
vault kv get -format=json kv/app/db
vault kv get -version=3 kv/app/db
vault kv list secret
vault kv delete secret/demo
vault kv undelete -version=3 secret/demo # no change in version number
vault kv rollback -version=1 secret/demo # version number is set back to 1
vault kv patch secret/demo  password="<password>" # add a specific key in the KV like update
vault kv destroy secret/demo  # permanently destroy data There's no coming back from that unless you restore from backup
vault kv destroy -version=1 secret/demo  # permanently destroy data There's no coming back from that unless you restore from backup
vault kv put kv/app/db@secrets.json
{
  "pass": "123",
  "user": "admin",
  "api": "a8ee4b50cce124"
}


# Cubbyhole Secrets Engine is used to store arbitrary secrets
# Cubbyhole Secrets Engine cannot be disabled, moved, or enabled multiple times
# - Each service token gets its own cubbyhole
# - A token cannot access another token's cubbyhole
# - Cubbyhole expires when the token does
vault write cubbyhole/training certification=associate
vault read cubbyhole/training
# Instead of sending secrets over the network, you can use cubbyhole's response wrapping feature
# Enables the retrieval of secrets from a path and Vault will store them inside of another token's cubbyhole
# - This token is called the wrapping token
# - The wrapping token is temporary and limited by a TTL
# - It is also a single-use token
# The wrapping token can be sent across the network and the user can unwrap the token to retrieve the real data (secrets)
# privacy by ensuring that any secret transmitted across the network is not the actual secret
# malfeasance detection by ensuring that only a single party can unwrap the token and gain access to the secrets (because it's a single-use token)
# limitation of the life time of the secret exposure because the wrapping token has a defined TTL
# You can get static or dynamic secrets using response wrapping
vault kv get -wrap-ttl=5m secrets/certification/associate
vault token lookup hvs.CAESIDgPWW9ok_h4KHGh2cyObTJ4WW
vault unwrap <wrapping-token>
# root token
vault login hvs.efKwelHBrZaucJE4M3dyuhIa
vault token create -policy=default
vault login hvs.CAESIPveBLh_3zcCT253onLORgKrZAlZBsCoFSThkwbVkvsdGh4KHGh2cy5mdEV6N0tuSmVoNGtmN1ZLRkpGYTlkcXM
# After login with this token, you should know that we have access to cubbyhole
vault write cubbyhole/training certification=associate
vault read cubbyhole/training 
# root token (cat ~/.vault-token or rm ~/.vault-token)
vault login hvs.efKwelHBrZaucJE4M3dyuhIa
# there's no value there because now that we're logged in as the root token, well again the root token has its own cubbyhole
vault read cubbyhole/training 
# Granting temporary access to secrets/app
vault kv get secrets/app
vault kv get -wrap-ttl=5m secrets/app
# wrapping_token: hvs.CAESIMy7ykjQqWHvkAtAMAT9Zjdom9hq7tiDVOgjMBFqBePCGh4KHGh2cy50aEVvMWtmVVFESWNaU1VFUU1aVW11ekk
# num_uses            1
# ttl                 4m5s
vault token lookup hvs.CAESIMy7ykjQqWHvkAtAMAT9Zjdom9hq7tiDVOgjMBFqBePCGh4KHGh2cy50aEVvMWtmVVFESWNaU1VFUU1aVW11ekk
# Login as a default user that create a default token above
vault login hvs.CAESIPveBLh_3zcCT253onLORgKrZAlZBsCoFSThkwbVkvsdGh4KHGh2cy5mdEV6N0tuSmVoNGtmN1ZLRkpGYTlkcXM
vault unwrap hvs.CAESIMy7ykjQqWHvkAtAMAT9Zjdom9hq7tiDVOgjMBFqBePCGh4KHGh2cy50aEVvMWtmVVFESWNaU1VFUU1aVW11ekk
# <wrapping-token>
# It will get the values of that secret
# Key         Value
# ---         -----
# data        map[password:admin321 url:https://my-app:8080 username:admin]
# metadata    map[created_time:2026-09-07T19:32:32.273596892Z custom_metadata:<nil> deletion_time:
# destroyed:false version:4]
# Because it only num_uses 1, you can use it once again 
vault unwrap hvs.CAESIMy7ykjQqWHvkAtAMAT9Zjdom9hq7tiDVOgjMBFqBePCGh4KHGh2cy50aEVvMWtmVVFESWNaU1VFUU1aVW11ekk


# Transit Secrets Engine (KMS KEY)
# Transit secrets engine provides functions for encrypting/decrypting data
# Applications can send cleartext data (All plaintext data must be base64-encoded) to Vault for encryption
# - Vault encrypts using the specified key and returns ciphertext to the app
# - The application NEVERhas access to the encryption key (stored in Vault)
# - Decouples storage from encryption and access control
# The Transit Secrets engine is not a database
# The idea is that applications send clear text data (All plaintext data must be base64-encoded) to vault to encrypt it with this specific encryption key, Vault just sends the encrypted data back to the application and then the application can go store it wherever
# Encryption keys are created and stored in Vault to process data (encryption/decryption operations)
# - Each application can have its own encryption key (or more!)
# - Apps must have permission to use the key for encryption/decryption operations, which is bound by the policy attached to its token
vault secrets enable transit
# The next step is to create one or many encryption keys used to encrypt/decrypt data
vault write -f transit/keys/vault_training
vault write -f transit/keys/training_rsatype="rsa-4096"
# Pass the cleartext data to Vault –specifying the actionand desired encryption key to use
# Key          Value
# -----        ---
# ciphertext   vault:v1:Fpyph6C7r5MUILiEiFhCobsGeh…………Cwt0mct1ttLokqikAr0PAg=  <-- So that's exactly what you want to store in db
# key_version  1
vault write transit/encrypt/training \
      plaintext=$(base64 <<< "Getting Started with HashiCorp Vault")
# Pass the ciphertext data to Vault –specifying the actionand desired encryption key to use for decryption operations
# Key          Value
# -----        ---
# plaintext    R2V0dGluZyBTdGFydGVkIHdpdGggSGFzaGlDb3JwIFZhdWx0Cg==
vault write transit/decrypt/training \
      ciphertext="vault:v1:Fpyph6C7r5MUILiEiFhCoJBxelQbsGeEahal5LhDPSoN6HkTO………"
printf 'R2V0dGluZyBTdGFydGVkIHdpdGggSGFzaGlDb3JwIFZhdWx0Cg==' | base64 -d
# Rotating Encryption Keys
# changing the encryption keys used to protect data, reducing the risk if an old key is compromised
# Rotate an Encryption Key
vault write -f transit/keys/training/rotate
vault read transit/keys/training
# Setting the Minimum Decryption Version
vault write transit/keys/training/config \
      min_decryption_version=4
# Rewrapping Ciphertext
# encrypting already-encrypted data again with a new encryption key, without decrypting the actual data
# Key          Value
# -----        ---
# ciphertext   vault:v1:Fpyph6C7r5MUILiEiFhCobsGeh…………Cwt0mct1ttLokqikAr0PAg=  
# key_version  4
vault write transit/rewrap/training \
      ciphertext="vault:v1:Fpyph6C7r5M......."


# AWS IAM User Method
# https://developer.hashicorp.com/vault/docs/auth/aws
vault secrets enable aws 
vault secrets list
vault write aws/config/client \
    secret_key=vCtSM8ZUEQ3mOFVlYPBQkf2sO6F/W7a5TVzrl3Oj \
    access_key=VKIAJBRHKH6EVTTNXDHA \
    region=us-west-2 
vault read aws/config/client
vault write -f aws/config/rotate-client 
vault read aws/config/client
vault write aws/roles/read-only \
    credential_type=iam_user \
    policy_arns="arn:aws:iam::aws:policy/ReadOnlyAccess"
vault read aws/roles/read-only 
vault read aws/creds/read-only
# vault lease revoke <lease_id>
vault lease revoke aws/creds/read-only/xxxxxxxx 
# If you want to revoke all active leases under that role
vault lease revoke -prefix aws/creds/read-only/

# AWS Role Method
# First, create an AWS IAM role "VaultS3AccessRole" and attach this permission policy to that AWS role
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::my-app-bucket"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::my-app-bucket/*"
    }
  ]
}
# Then configure the IAM role trust policy so the AWS identity used by Vault can assume it
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:user/vault-user"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
# The Vault AWS identity also needs permission to assume that role:
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::123456789012:role/VaultS3AccessRole"
    }
  ]
}

vault secrets enable aws 
vault secrets list
vault write aws/roles/s3-access \
    credential_type=assumed_role \
    role_arns="arn:aws:iam::123456789012:role/VaultS3AccessRole"
vault read aws/roles/s3-access
# Generate temporary AWS credentials
vault write aws/sts/s3-access ttl=1h
# You should receive something similar to:
# Key                Value
# ---                -----
# lease_id           aws/sts/s3-access/xxxxxxxx
# lease_duration     1h
# access_key         ASIAxxxxxxxxxxxx
# secret_key         xxxxxxxxxxxxxxxxxxxx
# session_token      xxxxxxxxxxxxxxxxxxxx
export AWS_ACCESS_KEY_ID="ASIAxxxxxxxx"
export AWS_SECRET_ACCESS_KEY="xxxxxxxx"
export AWS_SESSION_TOKEN="xxxxxxxx"
aws sts get-caller-identity
aws s3 ls 
aws s3 ls s3://my-app-bucket

# Database Secret Engine (Postgres)
# Enable the database secrets engine
vault secrets enable -path=postgres database
vault secrets list
# Configure the PostgreSQL connection
# The reason that we want to use username/password variables is that so they don't show up when we do a read against this path, because we don't want other people to know the username and password
# postgresql is the name of the connection configuration (db name)
vault write postgres/config/postgresql \
    plugin_name="postgresql-database-plugin" \
    allowed_roles="readonly" \
    connection_url="postgresql://{{username}}:{{password}}@127.0.0.1:5432/postgres?sslmode=disable" \
    username="vault_admin" \
    password="VaultAdminPassword"
# Create Postgres role under name ro
psql -h host-postgres -U postgres -d postgres    
# Then run:
CREATE ROLE ro NOLOGIN;
GRANT CONNECT ON DATABASE postgres TO ro;
GRANT USAGE ON SCHEMA public TO ro;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO ro;
ALTER DEFAULT PRIVILEGES IN SCHEMA public
GRANT SELECT ON TABLES TO ro;
# Check:
\du

# Create Vault DB role
# db_name="postgresql" should match the name of the connection configuration defined above
vault write postgres/roles/readonly \
    db_name="postgresql" \
    creation_statements="CREATE ROLE \"{{name}}\" WITH LOGIN PASSWORD '{{password}}' VALID UNTIL '{{expiration}}' INHERIT; GRANT ro TO \"{{name}}\";" \
    default_ttl="1h" \
    max_ttl="24h"
# Read configuration, credentials and role to verify its configuration
vault read postgres/config/postgresql
vault read postgres/roles/readonly
vault read postgres/creds/readonly
# Optionally to update the role
vault write postgres/roles/readonly revocation_statements="DROP ROLE IF EXISTS \"{{name}}\";"
# Rotate the root credentials for the PostgreSQL connection
# It will change the root credentials for the PostgreSQL connection
vault write -f postgres/rotate-root/postgresql
# Generate credentials
vault read postgres/creds/readonly
# Revoke the generated credentials
vault lease revoke <lease_id>
vault lease revoke -prefix postgres/creds/readonly
# Connect to the database using the generated credentials
psql -h host-postgres -U <generated_username> -W -d postgres
# Verify the connection to the database using the generated credentials
SELECT current_user;
\conninfo
create database ro;


# PKI Secrets Engine
# https://developer.hashicorp.com/vault/tutorials/pki/pki-engine
vault secrets enable pki
vault secrets list
# Set the maximum certificate lifetime for the PKI mount
# The default or the max least TTL for any certificates on the route will be ten years
vault secrets tune -max-lease-ttl=87600h pki
# Generate a root CA:
# Vault keeps the root CA private key internally
vault write pki/root/generate/internal \
    common_name="example.com" \
    ttl=87600h > /tmp/CA_cert.pem
vault read pki/cert/ca    
cat /tmp/CA_cert.pem
# Then configure the certificate and CRL URLs:
vault write pki/config/urls \
    issuing_certificates="http://localhost:8200/v1/pki/ca" \
    crl_distribution_points="http://localhost:8200/v1/pki/crl"
# Create a role that allows certificates for example.com and its subdomains:
vault write pki/roles/example-com \
    allowed_domains="example.com" \
    allow_subdomains=true \
    max_ttl="72h"    
# Now issue a certificate:
vault write pki/issue/example-com \
    common_name="www.example.com" \
    ttl="24h"
# You can also request SANs:
vault write pki/issue/example-com \
    common_name="app.example.com" \
    alt_names="api.example.com,www.example.com" \
    ttl="24h"
# To save the generated material into files:
vault write -format=json pki/issue/example-com \
    common_name="app.example.com" \
    ttl="24h" > /tmp/cert.json        
cat /tmp/cert.json
cat /tmp/cert.json | jq -r '.data.certificate' > app.crt
cat /tmp/cert.json | jq -r '.data.private_key' > app.key
cat /tmp/cert.json | jq -r '.data.issuing_ca' > ca.crt


# TOTP Secrets Engine
# One important distinction: the TOTP Secrets Engine is not the same thing as enabling MFA for Vault login. The secrets engine provides TOTP generation/validation functionality. Vault also has a separate TOTP MFA mechanism under its Identity system for requiring a second factor during authentication
# For Vault’s TOTP Secrets Engine, there are two common modes:
# 1. Vault generates TOTP codes from an existing TOTP secret.
# 2. Vault acts as the TOTP provider, generating the secret and validating codes.
vault secrets enable totp
vault secrets list
# Vault generates the TOTP secret
# Create a TOTP key for a user in Vault:
# Vault returns something like:
# Key        Value
# ---        -----
# barcode    iVBORw0KGgoAAA...
# url        otpauth://totp/MyCompany:admin@example.com?...
# The URL contains the generated TOTP secret, and the barcode is the QR code encoded as base64. By default Vault uses a 30-second period and 6-digit codes
vault write totp/keys/admin \
    generate=true \
    issuer="MyCompany" \
    account_name="admin@example.com"
# Check the key configuration:    
vault read totp/keys/admin
# List configured TOTP keys:
vault list totp/keys
# Generate a TOTP code from Vault
# Key     Value
# ---     -----
# code    428193
# The code changes according to the configured period, normally every 30 seconds
vault read totp/code/admin
# Validate a TOTP code
# If you're using Vault as the TOTP provider and want Vault to validate a code:
# Key      Value
# ---      -----
# valid    true
vault write totp/code/admin code=297939
# Custom settings
# You can explicitly control the algorithm, digits, period, and validation skew:
# Supported algorithms include SHA1, SHA256, and SHA512, while digits can be 6 or 8
vault write totp/keys/admin \
    generate=true \
    issuer="MyCompany" \
    account_name="admin@example.com" \
    algorithm="SHA1" \
    digits=6 \
    period=30 \
    skew=1
# Delete the TOTP key
vault delete totp/keys/admin

# Setup would be Vault userpass + TOTP MFA
# Enable userpass
vault auth enable userpass
# Create an example user:
vault write auth/userpass/users/admin \
    password="password123" \
    policies="admin"
# Get the userpass accessor:
# Vault uses this accessor when binding Identity aliases and MFA enforcement to the auth mount
USERPASS_ACCESSOR=$(vault auth list | awk '$1=="userpass/" {print $3}')
echo "$USERPASS_ACCESSOR"
vault auth list
# Create an Identity entity for the user
ENTITY_ID=$(vault write identity/entity name="admin" \
  | awk '$1=="id" {print $2}')
echo "$ENTITY_ID"
# Then connect the Vault Identity entity to the admin userpass account:
vault write identity/entity-alias \
    name="admin" \
    canonical_id="$ENTITY_ID" \
    mount_accessor="$USERPASS_ACCESSOR"
# Conceptually:
# userpass user: admin
#         |
#         v
# Identity Alias
#         |
#         v
# Identity Entity
#         |
#         v
# TOTP MFA Secret

# The alias name for a userpass identity should match its username

# Create the TOTP MFA method
# I recommend SHA1 for maximum authenticator compatibility:
# Vault's current TOTP Login MFA API supports SHA1, SHA256, or SHA512, with 6- or 8-digit codes.
TOTP_METHOD_ID=$(vault write \
  identity/mfa/method/totp \
  method_name="userpass-totp" \
  issuer="Vault" \
  period=30 \
  key_size=20 \
  algorithm=SHA1 \
  digits=6 \
  | awk '$1=="method_id" {print $2}')
echo "$TOTP_METHOD_ID"
# You can check the method:
vault read identity/mfa/method/totp/$TOTP_METHOD_ID
# Generate TOTP enrollment for admin
# Now generate the MFA secret specifically for the admin Identity entity
vault write -format=json \
    identity/mfa/method/totp/admin-generate \
    method_id="$TOTP_METHOD_ID" \
    entity_id="$ENTITY_ID" \
    > /tmp/totp-enrollment.json
cat /tmp/totp-enrollment.json
# The admin-generate endpoint stores that TOTP secret against the specified Identity entity.    
# Vault returns:
# {
#   "data": {
#     "barcode": "...",
#     "url": "otpauth://totp/..."
#   }
# } 

# Optionally, to destroy that enrollment
vault write \
    identity/mfa/method/totp/admin-destroy \
    method_id="$TOTP_METHOD_ID" \
    entity_id="$ENTITY_ID"

# To save the QR code:
# Important: admin-generate should only be run once for that entity/method unless you intentionally destroy and regenerate the enrollment. Vault requires the existing secret to be removed before replacing it.
# You can scan the QR code with a compatible authenticator app
awk -F'"' '/"barcode":/ {print $4}' /tmp/totp-enrollment.json \
    | base64 -d > /tmp/qr-code.png
ls -lh /tmp/qr-code.png
# Enforce TOTP for userpass
# Now create the login enforcement:
vault write identity/mfa/login-enforcement/userpass-totp \
    mfa_method_ids="$TOTP_METHOD_ID" \
    auth_method_accessors="$USERPASS_ACCESSOR"
# Check:
# This means every login through this particular userpass mount requires the configured MFA method
# You should see roughly:
# auth_method_accessors    [auth_userpass_xxxxx]
# mfa_method_ids           [4746fb81-....]
# name                     userpass-totp
vault read identity/mfa/login-enforcement/userpass-totp
# The QR code has been copied locally for scanning with an authenticator app
kubectl -n vault cp vault-0:/tmp/qr-code.png .\qr-code.png
# Test login
# Vault asks for the password
# After the password succeeds, it should ask for the TOTP
vault login -method=userpass username=admin



# Vault Secrets Operator

# What is the Vault Secrets Operator?
# The application just reads secrets from a regular Kubernetes secrets, and then the operator handles everything behind the scenes
# The Vault Secrets Operator (VSO) enables Kubernetes pods to read Vault-based secrets natively from Kubernetes Secrets
# - A Kubernetes-native controller that syncs secrets from Vault into Kubernetes Secrets (one-way sync)
# - Rather than have pods go directly to vault, they can read secrets natively from Kubernetes Secrets
# - Designed to make Vault secrets first-clase citizens in Kubernetes environments
┌───────────────────┐
│  HashiCorp Vault  │
│   Secret / KV     │
└─────────┬─────────┘
          │ 1. Sync
          ▼
┌───────────────────┐
│ Vault Secrets     │
│ Operator (VSO)    │
└─────────┬─────────┘
          │
          ▼
┌───────────────────────────┐
│    Kubernetes Cluster     │
│                           │
│   ┌───────────────────┐   │
│   │ Kubernetes Secret │   │
│   └─────────┬─────────┘   │
│             │ 2. Read     │
│        ┌────┼────┐        │
│        ▼    ▼    ▼        │
│      [Pod] [Pod] [Pod]    │
└───────────────────────────┘

# Supports Syncing from Multiple Secret Sources (Automatic secret drift and remediation when changes occur in Vault)
# Update Secrets When Workloads are Deployed (Supports Deployment, ReplicaSet, and StatefulSetresource types in Kubernetes)
# Watches for custom Kubernetes resources (CRDs) (efined by a CRD such as VaultStaticSecretor VaultDynamicSecretand will sync to a Kubernetes Secret)

┌──────────────────────────────────────┐
│          Kubernetes Cluster          │
│                                      │
│  ┌──────────────┐   ┌─────────────┐  │
│  │    CRDs      │──►│     VSO     │  │
│  │              │ 1 │             │  │
│  │ Tell VSO:    │   │ Watches CRDs│  │
│  │ - what sync  │   └──────┬──────┘  │
│  │ - where put  │          │ 2.Get   │
│  └──────────────┘          ▼         │
│                         ┌───────┐    │
│                         │ Vault │    │
│                         │Source │    │
│                         └───┬───┘    │
│                             │ 3.Sync │
│                             ▼        │
│                      ┌────────────┐  │
│                      │ K8s Secret │  │
│                      └─────┬──────┘  │
│                            │ 4.Read  │
│                            ▼         │
│                    ┌──────────────┐  │
│                    │ Application  │  │
│                    │    Pod       │  │
│                    └──────────────┘  │
└──────────────────────────────────────┘

# Vault Agent Injector vs. Vault Secrets Operator
# There are different methods for integrating Vault with Kubernetes
# - Most teams choose between the Vault Agent Injector and the Vault Secrets Operator for Kubernetes integration
# - VSO is the newer option and is gaining popularity with teams using GitOps and declarative infrastructure models

# Vault Agent Injector
# - Uses the sidecar pattern to modify pod specifications by injecting a Vault Agent container. Writes secrets to a shared volume
# - Applications read secrets from the shared volume
        ┌───────────────┐
        │ HashiCorp     │
        │ Vault         │
        └──────┬────────┘
               │ 1. Read
               ▼
┌─────────────────────────────┐
│       Kubernetes Pod        │
│                             │
│  ┌──────────┐ ┌──────────┐  │
│  │   App    │ │  Vault   │  │
│  │Container │ │  Agent   │  │
│  └────┬─────┘ └────┬─────┘  │
│       │ 3.Read     │ 2.Write│
│       └──────┬─────┘        │
│              ▼              │
│       ┌─────────────┐       │
│       │Shared Volume│       │
│       └─────────────┘       │
└─────────────────────────────┘

# When to Choose Vault Agent Injector over the Vault Secrets Operator
# This method is a strong fit when you need tight control over how and when secrets are injected. Choose it when your app or environment demands file-based secrets, renewal control, or more runtime flexibility.
# - Your app requires secrets as files (e.g., TLS certs)
# - You want runtime secret injection per pod lifecycle
# - You prefer a sidecar pattern for tighter control
# - You need fine-grained renewal control or template rendering

# Vault Secrets Operator
# - Uses a Kubernetes Secrets Operator with CRDs that is responsible for syncing Vault secrets to Kubernetes Secrets
# - Applications read secrets natively from Kubernetes Secrets
# - CRDs such as VaultStaticSecretor. VaultDynamicSecretand that created over all Kubernetes namespaces
        ┌───────────────┐
        │ HashiCorp     │
        │ Vault         │
        └──────┬────────┘
               │ 1. Sync / Read
               ▼
        ┌───────────────┐
        │      VSO      │
        │ Watches CRDs  │
        └──────┬────────┘
               │ 2. Create / Update
               ▼
        ┌────────────────┐
        │ Kubernetes     │
        │ Secret         │
        └──────┬─────────┘
               │ 3. Read
               ▼
        ┌────────────────┐
        │ Application    │
        │ Pod            │
        └────────────────┘
# When to Choose Vault Secrets Operator over the Vault Agent Injector
# If you prefer a simpler, more declarative approach that integrates easily with GitOps or CI/CD pipelines, the Vault Secrets Operator might be the better fit. It works best when you want secrets to feel native to Kubernetes
# - You want a GitOps-friendly, declarative approach
# - You prefer using native Kubernetes Secrets, or your applications require it
# - You want more straightforward integration without sidecars or dealing with mutating webhooks
# - You're managing many apps across teams with centralized sync logic


# How Do I Install the Vault Secrets Operator?
# Using the Helm chart is the recommended method for installing and configuring the VSO
# The Vault Secrets Operator is installed in a separate namespace such as vault-secrets-operator
helm repo add hashicorp https://helm.releases.hashicorp.com
helm repo update
helm search repo hashicorp/vault-secrets-operator
helm search repo -l hashicorp/vault-secrets-operator
helm install --version 1.6.0 --create-namespace \
             --namespace vault-secrets-operator \
             vault-secrets-operator hashicorp/vault-secrets-operator
# Verify the Vault Secrets Operator is Running
kubectl -n vault-secrets-operator get pods 
kubectl get crds | grep secrets.hashicorp.com

# Prerequisites for Vault Secrets Operator Authentication with Kubernetes
# Static Secrets Authentication with Kubernetes
# Note: role: vso-auth will rely on enabling the Kubernetes auth method in Vault and creating a corresponding role that maps to this service account
# Enabling the Kubernetes auth method in Vault
vault auth enable kubernetes
# Configure it when Vault is running inside the Kubernetes cluster
# Vault can automatically use the pod's mounted service-account token and CA certificate when running inside Kubernetes
vault write auth/kubernetes/config \
    kubernetes_host="https://192.168.100.210:6443"
# Verify
vault read auth/kubernetes/config
# Displying ServiceAccount used by your Vault pod
kubectl -n vault get serviceaccounts
kubectl -n vault get pod vault-0 -o jsonpath='{.spec.serviceAccountName}{"\n"}'
# Creating a role in Vault that maps to the Kubernetes service account
vault write auth/kubernetes/role/vso-auth \
    bound_service_account_names=vault \
    # The namespace of the Kubernetes service account that this role will be bound to
    # bound_service_account_namespaces="vault,default,dev*" 
    bound_service_account_namespaces="*" 
    policies="default,vso-policy" \
    ttl=24h
# Verify
vault read auth/kubernetes/role/vso-auth
# Enable KV Secrets Engine
vault secrets enable -path=secret -description="KV v2 Secrets Engine" kv-v2
vault secrets list
# Create a secret in the KV v2 engine
vault kv put secret/my-secret username="my-user" password="my-password"
# Creating a policy in Vault that can be associated with the Kubernetes role
# For example, if your KV v2 secret engine is mounted at "secret/", the policy should reference "secret/data/*" to access all data within the KV v2 engine
vault policy write vso-policy - <<EOF
# KV v2 secrets
path "secret/data/*" {
  capabilities = ["read", "list"]
}

path "secret/metadata/*" {
  capabilities = ["read", "list"]
}

# PostgreSQL dynamic credentials
path "postgres/creds/readonly" {
  capabilities = ["read"]
}

# PKI certificate issuance
path "pki/issue/pki-role" {
  capabilities = ["create", "update"]
}  
EOF
# Verify
vault read sys/policies/acl/vso-policy

# Dynamic Secrets Authentication with Kubernetes
# Enable the database secrets engine
vault secrets enable -path=postgres -description="PostgreSQL Database Secrets Engine" database
vault secrets list
# Configure the PostgreSQL connection
# The reason that we want to use username/password variables is that so they don't show up when we do a read against this path, because we don't want other people to know the username and password
# postgresql is the name of the connection configuration (db name)
vault write postgres/config/postgresql \
    plugin_name="postgresql-database-plugin" \
    allowed_roles="readonly" \
    connection_url="postgresql://{{username}}:{{password}}@127.0.0.1:5432/postgres?sslmode=disable" \
    username="vault_admin" \
    password="VaultAdminPassword"
# verify
vault read postgres/config/postgresql
# Create Postgres role under name ro
psql -h host-postgres -U postgres -d postgres    
# Then run:
CREATE ROLE ro NOLOGIN;
GRANT CONNECT ON DATABASE postgres TO ro;
GRANT USAGE ON SCHEMA public TO ro;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO ro;
ALTER DEFAULT PRIVILEGES IN SCHEMA public
GRANT SELECT ON TABLES TO ro;
# Check:
\du
# Create Vault DB role
# db_name="postgresql" should match the name of the connection configuration defined above
vault write postgres/roles/readonly \
    db_name="postgresql" \
    creation_statements="CREATE ROLE \"{{name}}\" WITH LOGIN PASSWORD '{{password}}' VALID UNTIL '{{expiration}}' INHERIT; GRANT ro TO \"{{name}}\";" \
    default_ttl="1h" \
    max_ttl="24h"
# verify
vault read postgres/roles/readonly
# Read the generated credentials for the readonly role
vault read postgres/creds/readonly

# VaultPKISecret
# Enable PKI Secrets Engine
# https://developer.hashicorp.com/vault/tutorials/pki/pki-engine
vault secrets enable pki -description="PKI secrets engine for issuing certificates"
vault secrets list
# Set the maximum certificate lifetime for the PKI mount
# The default or the max least TTL for any certificates on the route will be ten years
vault secrets tune -max-lease-ttl=87600h pki
# Generate a root CA:
# Vault keeps the root CA private key internally
vault write pki/root/generate/internal \
    common_name="example.com" \
    ttl=87600h > /tmp/CA_cert.pem
vault read pki/cert/ca    
cat /tmp/CA_cert.pem
# Then configure the certificate and CRL URLs:
vault write pki/config/urls \
    issuing_certificates="http://localhost:8200/v1/pki/ca" \
    crl_distribution_points="http://localhost:8200/v1/pki/crl"
# Create a role that allows certificates for example.com and its subdomains:
vault write pki/roles/pki-role \
    allowed_domains="example.com" \
    allow_subdomains=true \
    max_ttl="72h"    
       


# Configuring Connectivity and Authentication
# STEP01: Configuring Access to Vault
# Just like any other Vault client, the Vault Secrets Operator needs to know where Vault is located and how to authenticate in order to retrieve secrets for Kubernetes workloads
              ┌──────────────────┐
              │ HashiCorp Vault  │
              └────────┬─────────┘
                       ▲
                       │ Authenticate
                       │ + Read Secrets
                       │
┌──────────────────────┴──────────────────────┐
│              Kubernetes Cluster             │
│                                             │
│        ┌──────────────────────────┐         │
│        │ Vault Secrets Operator   │         │
│        └──────────────────────────┘         │
│                                             │
└─────────────────────────────────────────────┘

Address : https://vault.example.com:8200
Auth    : kubernetes
Role    : vso-role

# Supported Auth Methods
# - The Vault Secrets Operator supports multiple authentication methods to connect to Vault
# - Choosing the correct method depends on your environment and how you want to manage access
# - VSO uses these auth methods to authenticate to Vault and retrieve secrets on behalf of your Kubernetes workloads
# 1- Kubernetes = Authenticate workloads running in Kubernetes
# 2- JWT        = Authenticate using JSON Web Tokens
# 3- AppRole    = Authenticate applications using RoleID + SecretID
# 4- AWS        = Authenticate AWS workloads/instances
# 5- GCP        = Authenticate Google Cloud workloads

# VaultConnection
# This CRD provides the configuration details to connect to a single Vault cluster
# All secret replication resources rely on VaultConnectionas the foundational config for connecting to Vault and syncing secrets to the target namespace
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultConnection
metadata:
  name: connection-vault
  namespace: vault
spec:
  address: http://vault-active.vault.svc.cluster.local:8200
  skipTLSVerify: false
# Verify 
kubectl -n vault get VaultConnection

# STEP02: VaultAuth 
# A Custom Resource Definition (CRD) that provides the configuration for VSO to authenticate against the Vault cluster
# The VaultAuthresource configures how the operator authenticates to Vault using methods like Kubernetes or AppRole. It includes a vaultConnectionRefto associate it with the correct VaultConnection
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultAuth
metadata:
  name: vault-auth
  namespace: vault
spec:
  vaultConnectionRef: connection-vault
  method: kubernetes
  mount: kubernetes
  kubernetes:
    role: vso-auth
    serviceAccount: vault
  allowedNamespaces:
    - default
    - vault 
    - "*"

# Verify 
kubectl -n vault get VaultAuth

# STEP03: Sync a Secret
# Vault Secret Custom Resource Definitions (CRDs)
# - VaultStaticSecret: This CRD defines how the operator syncs a single static secretfrom Vault to a Kubernetes Secret (KVv1 or KVv2)
# - VaultDynamicSecret: This CRD syncs a dynamic Vault secret—generated on demand—to a Kubernetes Secret (Database, AWS or GCP)  
# - VaultPKISecret: This CRD configures the operator to generate a certificate using the PKI engine and sync it to a Kubernetes Secret (PKI)

# VaultStaticSecret
# Sync a single static secret from Vault’s KV engine to a Kubernetes Secret 
# The VaultStaticSecretCRD is used for KVv1 or KVv2 secrets that don’t change often and are manually managed
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultStaticSecret
metadata:
  name: my-static-secret
  namespace: default
spec:
  # vaultAuthRef: <namespace>/<name> of the VaultAuth resource to use for authentication
  vaultAuthRef: vault/vault-auth
  mount: secret
  path: my-secret
  type: kv-v2
  destination:
    create: true
    # Name of the Kubernetes Secret to create
    name: my-k8s-secret
  refreshAfter: 1h
# Verify
kubectl -n default get VaultStaticSecret 
kubectl -n default describe VaultStaticSecret my-static-secret
kubectl -n default get secret my-k8s-secret
kubectl -n default describe secret my-k8s-secret
# Simple example to test VaultStaticSecret
# Create a ServiceAccount for the Vault Secrets Operator for every namespace where it needs to access secrets
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vault
  namespace: default

---  
apiVersion: apps/v1
kind: Deployment
metadata:
  name: test-vault-secret
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: test-vault-secret
  template:
    metadata:
      labels:
        app: test-vault-secret
    spec:
      # Optional: specify the ServiceAccount for the Vault Secrets Operator
      serviceAccountName: vault
      containers:
        - name: test
          image: busybox:1.36
          command:
            - sh
            - -c
            - sleep 3600
          envFrom:
            - secretRef:
                name: my-k8s-secret

# VaultDynamicSecret
# Dynamically generate and sync credentials like database or cloud access keys
# The VaultDynamicSecretCRD is best for secrets that need to be generated on demand from dynamic secrets engines
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultDynamicSecret
metadata:
  name: my-db-secret
  namespace: default
spec:
  # vaultAuthRef: <namespace>/<name> of the VaultAuth resource to use for authentication
  vaultAuthRef: vault/vault-auth
  mount: postgres
  # path must point to the credentials endpoint
  path: creds/readonly
  destination:
    create: true
    name: my-dynamic-db-secret
  refreshAfter: 30m
# Simple example to test VaultDynamicSecret
# Create a ServiceAccount for the Vault Secrets Operator for every namespace where it needs to access secrets
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vault
  namespace: default

---  
apiVersion: apps/v1
kind: Deployment
metadata:
  name: test-dynamic-secret
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: test-dynamic-secret
  template:
    metadata:
      labels:
        app: test-dynamic-secret
    spec:
      # Optional: specify the ServiceAccount for the Vault Secrets Operator
      serviceAccountName: vault
      containers:
        - name: test
          image: busybox:1.36
          command:
            - sh
            - -c
            - sleep 3600
          envFrom:
            - secretRef:
                name: my-dynamic-db-secret
# Verify              
kubectl -n default get VaultDynamicSecret
kubectl -n default describe VaultDynamicSecret my-db-secret
kubectl -n default get secret my-dynamic-db-secret
kubectl -n default describe secret my-dynamic-db-secret

# VaultPKISecret
# Generate TLS certificates using Vault’s PKI engine and sync them into Kubernetes
# The VaultPKISecretCRD is ideal for automating short-lived certificates directly into Kubernetes
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultPKISecret
metadata:
  name: my-pki-cert
  namespace: default
spec:
  vaultAuthRef: vault/vault-auth
  mount: pki
  role: pki-role
  commonName: web.internal.example.com
  destination:
    create: true
    name: my-pki-secret
  ttl: 24h
# Simple example to test VaultPKISecret
# Create a ServiceAccount for the Vault Secrets Operator for every namespace where it needs to access secrets
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vault
  namespace: default

---  
apiVersion: apps/v1
kind: Deployment
metadata:
  name: test-pki-secret
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: test-pki-secret
  template:
    metadata:
      labels:
        app: test-pki-secret
    spec:
      containers:
        - name: test
          image: busybox:1.36
          command:
            - sh
            - -c
            - sleep 3600
          volumeMounts:
            - name: pki-secret
              # /etc/tls/certificate   → server certificate
              # /etc/tls/private_key   → private key
              # /etc/tls/issuing_ca    → CA / issuing certificate            
              mountPath: /etc/tls
              readOnly: true
      volumes:
        - name: pki-secret
          secret:
            secretName: my-pki-secret
# Verify                         
kubectl -n default get VaultPKISecret
kubectl -n default describe VaultPKISecret my-pki-cert
kubectl -n default get secret my-pki-secret
kubectl -n default describe secret my-pki-secret

# Vault Secrets Operator (Additional Features)



vault secrets enable pki -description="PKI secrets engine for issuing certificates"
vault secrets list
# Set the maximum certificate lifetime for the PKI mount
# The default or the max least TTL for any certificates on the route will be ten years
vault secrets tune -max-lease-ttl=87600h pki
# Generate a root CA:
# Vault keeps the root CA private key internally
vault write pki/root/generate/internal \
    common_name="example.com" \
    ttl=87600h > /tmp/CA_cert.pem
vault read pki/cert/ca    
cat /tmp/CA_cert.pem
# Then configure the certificate and CRL URLs:
vault write pki/config/urls \
    issuing_certificates="http://localhost:8200/v1/pki/ca" \
    crl_distribution_points="http://localhost:8200/v1/pki/crl"
# Create a role that allows certificates for example.com and its subdomains:
vault write pki/roles/pki-role \
    allowed_domains="example.com" \
    allow_subdomains=true \
    max_ttl="72h"    
       


