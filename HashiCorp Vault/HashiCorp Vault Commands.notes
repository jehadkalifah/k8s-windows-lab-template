vault auth disable approle
vault auth list


# They are two separate authentication methods:
# - Human login: admin → Userpass → admin policy
# - Machine/service login: demo AppRole → RoleID + SecretID → demo policy

cat > /tmp/admin.hcl <<'EOF'
path "*" {
  capabilities = ["create", "read", "update", "patch", "delete", "list", "sudo"]
}
EOF

vault policy write admin /tmp/admin.hcl
vault policy read admin

vault auth enable userpass
vault policy list
vault write auth/userpass/users/admin password=<password> policies=admin
vault list auth/userpass/users
vault read auth/userpass/users/admin
vault login -method=userpass username=admin 
vault policy list


vault auth enable approle
cat > /tmp/demo.hcl <<'EOF'
path "secret/data/demo/*" {
  capabilities = ["create", "read", "update", "delete"]
}

path "secret/metadata/demo/*" {
  capabilities = ["read", "list", "delete"]
}
EOF

vault policy write demo /tmp/demo.hcl
vault policy read demo
vault write auth/approle/role/demo \
  token_policies="demo" \
  token_ttl="1h" \
  token_max_ttl="4h" \
  secret_id_ttl="24h" \
  secret_id_num_uses=10
vault read auth/approle/role/demo/role-id
vault write -f auth/approle/role/demo/secret-id
vault write auth/approle/login \
  role_id="<ROLE_ID>" \
  secret_id="<SECRET_ID>"


# keep that in mind when you're working with audit devices
# it's important to enable and use more than one audit device, because if you're simply using
# one and it's unavailable, vault will no longer respond to clients until it can actually write that audit
vault login <root_token>
vault audit list 
vault audit enable file file_path=/vault/logs/vault_audit.log --description="File audit log"
vault audit list --detailed

# So once a secrets engine is enabled, vault needs to be able to authenticate and communicate with the
# platform in order to generate dynamic credentials for its clients
vault secrets enable aws
vault write aws/config/root \
  access_key=<AWS_ACCESS_KEY> \
  secret_key=<AWS_SECRET_KEY> \
  region=us-east-1
vault read aws/config/root
# Role allows vault to generate AWS credentials with the AmazonS3FullAccess policy attached to them
vault write aws/roles/s3fullaccess \
  credential_type=iam_user \
  policy_arn=arn:aws:iam::aws:policy/AmazonS3FullAccess
vault list aws/roles
vault read aws/roles/s3fullaccess
# Dynamic credentials are generated on demand and are unique to each request. This means that each time a client requests AWS credentials from vault, a new set of credentials is generated with a unique access key and secret key.
vault read aws/creds/s3fullaccess
vault secrets disable aws
vault secrets tune -max-lease-ttl=24h aws
vault secrets move -path=aws aws
vault secrets enable -path=secret kv-v2
vault secrets list


# Secret engine KV
vault secrets enable -path=secret kv-v2
vault secrets enable -path=secret -version=2 kv
vault secrets list
vault secrets list --detailed
vault kv put secret/demo username="demo" password="<password>"
vault kv list secret
vault kv get secret/demo
vault kv -version=1 get secret/demo
vault kv delete -version=1 secret/demo
vault kv undelete -version=1 secret/demo
vault kv destroy -version=1 secret/demo
vault kv patch secret/demo password=<password> url=https://my-app:8080  
vault kv rollback -version=1 secret/demo


# Secret engine Database
vault secrets enable database
# Username should be a user with the ability to create other users and grant them privileges. The connection URL should be in the format of postgresql://username:password@host:port/database?sslmode=disable
vault write database/config/postgresql \
  plugin_name=postgresql-database-plugin \
  allowed_roles="postgresql-role" \
  connection_url="postgresql://{{username}}:{{password}}@keycloak-postgres.keycloak.svc.cluster.local:5432/postgres?sslmode=disable" \
  username="keycloak" \
  password="67ae8223e4461990b1132b1715ab34b7bc1ca548b73c0b55"

vault list database/config
vault read database/config/postgresql

# Add a new role to the database secrets engine
vault write database/config/postgresql allowed_roles=postgresql-role 

# db_name references the name of the database configuration that was created in the previous step. The creation_statements parameter is a SQL statement that will be executed to create a new role in the database. The default_ttl and max_ttl parameters specify the time-to-live for the generated credentials.
vault write database/roles/postgresql-role \
  db_name=postgresql \
  creation_statements="CREATE ROLE \"{{name}}\" WITH LOGIN PASSWORD '{{password}}' VALID UNTIL '{{expiration}}'; GRANT CONNECT ON DATABASE postgres TO \"{{name}}\";" \
  default_ttl="1h" \
  max_ttl="24h"

vault read database/roles/postgresql-role
vault read database/creds/postgresql-role 
vault lease revoke <lease_id>
# Revoke all leases with a specific prefix
vault lease revoke -prefix database/
vault lease revoke -prefix database/creds/postgresql-role

# List created users in the database
psql -U keycloak
psql -h POSTGRES_HOST -p 5432 -U keycloak -d postgres
SELECT rolname FROM pg_roles ORDER BY rolname;
SELECT rolname, rolcanlogin, rolsuper, rolcreatedb, rolcreaterole, rolvaliduntil FROM pg_roles ORDER BY rolname;
