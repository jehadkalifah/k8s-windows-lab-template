# Kubernetes Windows Lab - example machine-local configuration
#
# IMPORTANT
# ---------
# Run this ONCE at the beginning of every interactive PowerShell session:
#
#   . .\scripts\lab-config.ps1
#
# The leading dot + space is PowerShell dot-sourcing. It loads these
# environment variables into the CURRENT PowerShell session.
#
# This file is ignored by Git. Edit it per Windows machine/LAN.

# Physical adapter bridged into the three VirtualBox VMs.
# List valid names with:
#   .\scripts\show-bridges.ps1
$env:K8S_BRIDGE_ADAPTER = "TP-Link Wireless USB Adapter"

# K3s/Flannel inter-node interface.
# VirtualBox NIC order in this lab:
#   eth0 = NAT/internet
#   eth1 = host-only Kubernetes inter-node network (192.168.56.0/24)
#   eth2 = bridged physical LAN (192.168.100.0/24)
#
# IMPORTANT: Flannel must use eth1. All VMs receive 10.0.2.15 on the NAT
# adapter, so using eth0 breaks cross-node pod networking and cluster DNS.

# Static node IPs on the physical 192.168.100.0/24 LAN.
# Reserve/exclude these from your router DHCP pool.

# K3s / Flannel inter-node interface.
# eth0 = VirtualBox NAT
# eth1 = 192.168.56.0/24 host-only K3s inter-node network
# eth2 = 192.168.100.0/24 bridged physical LAN
$env:K3S_FLANNEL_IFACE = "eth1"

$env:K3S_MASTER_LAN_IP  = "192.168.100.210"
$env:K3S_WORKER1_LAN_IP = "192.168.100.211"
$env:K3S_WORKER2_LAN_IP = "192.168.100.212"

# Remote Kubernetes API endpoint.
# This is included as a TLS SAN in the K3s API certificate.
$env:K3S_API_LAN_IP = "192.168.100.210"

# MetalLB application LoadBalancer range.
# Do NOT overlap this with DHCP or the node IPs above.
$env:METALLB_POOL_START = "192.168.100.240"
$env:METALLB_POOL_END   = "192.168.100.245"

# Optional VM sizing overrides.
# $env:K8S_MASTER_CPUS = "4"
# $env:K8S_MASTER_MEM  = "6144"
# $env:K8S_WORKER_CPUS = "2"
# $env:K8S_WORKER_MEM  = "4096"


# Shared Stage 2 publishing Gateway.
$env:K8S_GATEWAY_NAMESPACE = "istio-ingress"
$env:K8S_GATEWAY_NAME      = "public-gateway"


# Optional Longhorn hostname override.
# Leave empty to auto-generate from the actual Gateway IP using nip.io.
# Example: longhorn.192-168-100-240.nip.io
$env:LONGHORN_PUBLISH_HOST = ""
